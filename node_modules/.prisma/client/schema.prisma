datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  email         String       @unique
  passwordHash  String       @map("password_hash")
  avatarUrl     String       @default("Img/Avatar.jpg") @map("avatar_url")
  createdAt     DateTime     @default(now()) @map("created_at")
  inventories   Inventory[]
  redeemedCodes RedeemCode[]

  @@map("users")
}

model Game {
  id          String       @id
  title       String
  genre       String
  imagePath   String       @map("image_path")
  linkPath    String       @map("link_path")
  description String
  developer   String
  price       Float
  currency    String       @default("UAH")
  createdAt   DateTime     @default(now()) @map("created_at")
  inventories Inventory[]
  redeemCodes RedeemCode[]
  reviews     Review[]

  @@map("games")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  gameId      String   @map("game_id")
  purchasedAt DateTime @default(now()) @map("purchased_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("inventory")
}

model RedeemCode {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  gameId           String    @map("game_id")
  isRedeemed       Boolean   @default(false) @map("is_redeemed")
  redeemedByUserId Int?      @map("redeemed_by_user_id")
  redeemedAt       DateTime? @map("redeemed_at")
  game             Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  redeemedByUser   User?     @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@map("redeem_codes")
}

model Review {
  id        Int      @id @default(autoincrement())
  gameId    String   @map("game_id")
  userEmail String   @map("user_email")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  userEmail String   @map("user_email")
  title     String
  content   String
  status    String   @default("Open")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("support_tickets")
}
